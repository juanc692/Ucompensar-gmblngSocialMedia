{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "gamblingP": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/app/components/games/pacman/img",
                "output": "assets/pacman/img"
              },
              {
                "glob": "**/*",
                "input": "src/app/components/games/pacman/sound",
                "output": "assets/pacman/sound"
              },
              {
                "glob": "Quadrit.ttf",
                "input": "src/app/components/games/pacman/fonts",
                "output": "assets/pacman/fonts"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.scss"

            ],
            "scripts": [
              "src/app/components/games/pacman/ts/jquery.js",
              "src/app/components/games/pacman/ts/jquery-buzz.js",
              "src/app/components/games/pacman/ts/game.js",
              "src/app/components/games/pacman/ts/tools.js",
              "src/app/components/games/pacman/ts/board.js",
              "src/app/components/games/pacman/ts/paths.js",
              "src/app/components/games/pacman/ts/bubbles.js",
              "src/app/components/games/pacman/ts/fruits.js",
              "src/app/components/games/pacman/ts/pacman.js",
              "src/app/components/games/pacman/ts/ghosts.js",
              "src/app/components/games/pacman/ts/home.js",
              "src/app/components/games/pacman/ts/sound.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "gamblingP:build:production"
            },
            "development": {
              "buildTarget": "gamblingP:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
